{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instadateclub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "instadateclub",
      "database_id": "653ff8ff-ddfd-4b61-9608-a46485e6645e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROFILE_IMAGES",
      "bucket_name": "instadate-profile-images"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Daily cron drives the scheduled() handler: matchmaking refresh + account purge job.
  "triggers": {
    "crons": [
      "23 3 * * *"
    ]
  },
  // Comma-separated user ids granted break-glass super-admin (full /api/admin/*).
  // Acts as the bootstrap before any DB role is assigned; ongoing roles live in
  // users.role ('member' | 'moderator' | 'admin'). Override per-env or via secret.
  "vars": {
    // Fail-closed prod marker: disables dev-only behaviour (seeder, magic-link devLink).
    "ENVIRONMENT": "production",
    // Must stay false in prod so the seeder never runs on the request hot path.
    "DATABASE_EMPTY": "false",
    // SMS provider selector — set to "msg91" or "twilio" once provider secrets are added.
    "SMS_PROVIDER": "",
    "ADMIN_USER_IDS": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ChatRoom"]
    }
  ]
}
